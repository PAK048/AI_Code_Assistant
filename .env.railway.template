# CodeEcho Backend - Railway Environment Variables Template
# Copy this file to .env for local development
# For Railway deployment, set these in Railway Dashboard

# ============================================
# DATABASE CONFIGURATION
# ============================================

# MongoDB Connection String (Required)
# Get from MongoDB Atlas or Railway MongoDB plugin
# Format: mongodb+srv://username:password@cluster.mongodb.net/codeecho
MONGODB_URI=

# ============================================
# VECTOR DATABASE (Qdrant)
# ============================================

# Qdrant Cloud URL (Required)
# Format: https://your-cluster.qdrant.io
QDRANT_URL=

# Qdrant API Key (Required for cloud)
QDRANT_API_KEY=

# Qdrant Collection Name (Optional, defaults to "Hackathons")
QDRANT_COLLECTION=Hackathons

# ============================================
# AUTHENTICATION & SECURITY
# ============================================

# JWT Secret for token signing (Required)
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Node Environment (Required)
NODE_ENV=production

# ============================================
# CORS & FRONTEND
# ============================================

# Frontend URL for CORS (Required after frontend deployment)
# Add your deployed frontend URL here
# Example: https://your-frontend.vercel.app
FRONTEND_URL=

# ============================================
# IBM WATSONX.AI CONFIGURATION
# ============================================

# Watsonx API Key (Required for RAG embeddings)
WATSONX_API_KEY=

# Watsonx URL (Required)
# Usually: https://us-south.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Watsonx Project ID (Required)
WATSONX_PROJECT_ID=

# Watsonx Model for text generation (Optional)
WATSONX_MODEL=meta-llama/llama-3-70b-instruct

# Watsonx Embedding Model (Optional)
WATSONX_EMBEDDING_MODEL=sentence-transformers/all-minilm-l6-v2

# ============================================
# GITHUB INTEGRATION (Optional)
# ============================================

# GitHub Personal Access Token
GITHUB_TOKEN=

# GitHub Repository Owner
GITHUB_OWNER=

# GitHub Repository Name
GITHUB_REPO=

# ============================================
# OPENAI CONFIGURATION (Optional)
# ============================================

# OpenAI API Key (for fallback/additional features)
OPENAI_API_KEY=

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Server Port (Railway sets this automatically)
PORT=5000

# Sandbox directory for code execution
CODEECHO_SANDBOX=chat_gpt

# Command execution timeout in seconds
CODEECHO_CMD_TIMEOUT=120

# Thread ID for LangGraph checkpointing
CODEECHO_THREAD_ID=17

# ============================================
# DEPLOYMENT NOTES
# ============================================
# 
# REQUIRED VARIABLES (must be set before deployment):
#   - MONGODB_URI
#   - QDRANT_URL
#   - QDRANT_API_KEY
#   - JWT_SECRET
#   - NODE_ENV
#   - WATSONX_API_KEY
#   - WATSONX_URL
#   - WATSONX_PROJECT_ID
#
# RECOMMENDED (set after frontend deployment):
#   - FRONTEND_URL
#
# OPTIONAL (for enhanced features):
#   - GITHUB_TOKEN, GITHUB_OWNER, GITHUB_REPO
#   - OPENAI_API_KEY
#   - WATSONX_MODEL, WATSONX_EMBEDDING_MODEL
#
# ============================================
